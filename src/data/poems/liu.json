[
  {
    "id": "tang-liu-0001",
    "title": "赋得古原草送别",
    "author": "白居易",
    "dynasty": "唐",
    "form": "诗",
    "content": [
      "离离原上草，",
      "一岁一枯荣。",
      "野火烧不尽，",
      "春风吹又生。",
      "远芳侵古道，",
      "晴翠接荒城。",
      "又送王孙去，",
      "萋萋满别情。"
    ],
