    "author": "苏轼",
    "dynasty": "宋",
    "form": "词",
    "content": [
      "缺月挂疏桐，漏断人初静。",
      "谁见幽人独往来，缥缈孤鸿影。",
      "惊起却回头，有恨无人省。",
      "拣尽寒枝不肯栖，寂寞沙洲冷。"
    ],
