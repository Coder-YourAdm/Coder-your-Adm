# ── 使用方法 ──────────────────────────────────────────────
# AI 诗画开箱即用：默认走线上代理（Render 免费），无需任何配置。
# 本文件只是可选覆盖项：复制为 .env.local（git 会忽略它）后按需修改。
# ⚠️ 千万不要把真实 key 提交到仓库或发到群里。

# ── Supabase（联网对战 S3-T05 用，可选）────────────────────
# 未配置时，对战自动降级为「同设备双开」与「人机」模式，功能仍可演示。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── AI 诗画（S3-T07，默认开箱即用）─────────────────────────
# 留空（或整行删掉）→ 走线上代理，真实生图，无需 key。
# 填 "mock" → 强制本地演示模式（占位图，适合离线演示）。
# 填 http://localhost:8788/api → 走本地代理（仅供开发者调试代理层）。
#   本地代理需要 key：注册 https://cloud.siliconflow.cn → 实名 → API 密钥，
#   填到下面 SILICONFLOW_API_KEY（生图按张免费，不扣余额）。
VITE_AI_IMAGE_API_BASE=
SILICONFLOW_API_KEY=
